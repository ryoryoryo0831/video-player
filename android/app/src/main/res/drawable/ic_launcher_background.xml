<?xml version="1.0" encoding="utf-8"?>
<!-- アプリのアイコンの背景：青から紫へのグラデーション -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF3D7BFF" android:offset="0" />
                <item android:color="#FF6A5CFF" android:offset="0.5" />
                <item android:color="#FFA455F2" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 左上をほんのり明るくして立体感を出す -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="30"
                android:centerY="24"
                android:gradientRadius="70"
                android:type="radial">
                <item android:color="#33FFFFFF" android:offset="0" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
