<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- タップ・スワイプなどのジェスチャーを受け取る透明なレイヤー（TalkBack ではダブルタップで操作パネルを出し入れ） -->
    <View
        android:id="@+id/touchLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/player_show_controls" />

    <!-- 開いている・読み込んでいる間のくるくる（再生ボタンを囲む大きさ。出すのは少し待ってから） -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/player_loading"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#FFFFFF"
        app:indicatorSize="100dp"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <!-- 上部バー -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/titleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- A-Bリピート中の表示（タップで解除） -->
        <TextView
            android:id="@+id/abIndicator"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_ab_badge"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/castButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/cast"
            android:src="@drawable/ic_cast" />

        <ImageButton
            android:id="@+id/pipButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/pip"
            android:src="@drawable/ic_pip" />

        <ImageButton
            android:id="@+id/moreButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- 画面中央：前へ・再生/一時停止・次へ（大きく押しやすく） -->
    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/previous"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginHorizontal="36dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/play_pause"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/next"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

    <!-- 下部コントロール -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCurrent"
                style="@style/PlayerTime"
                android:text="@string/player_time_zero" />

            <!-- 押しやすいように高さは 48dp（線の太さ・見た目は変えない） -->
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:paddingVertical="16dp" />

            <TextView
                android:id="@+id/timeDuration"
                style="@style/PlayerTime"
                android:text="@string/player_time_zero" />
        </LinearLayout>

        <!-- 道具のボタン（画面の幅に合わせて均等に並べる） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/lockButton"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/lock"
                android:src="@drawable/ic_lock_open" />

            <ImageButton
                android:id="@+id/subtitleButton"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/subtitles"
                android:src="@drawable/ic_subtitles" />

            <ImageButton
                android:id="@+id/audioButton"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/audio_track"
                android:src="@drawable/ic_audiotrack" />

            <ImageButton
                android:id="@+id/aspectButton"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/aspect"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/rotateButton"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/rotate"
                android:src="@drawable/ic_rotate" />

            <TextView
                android:id="@+id/speedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/speed"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="1x"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/repeatButton"
                style="@style/PlayerToolButton"
                android:alpha="0.5"
                android:contentDescription="@string/repeat"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>
    </LinearLayout>

    <!-- キャスト中の表示 -->
    <TextView
        android:id="@+id/castInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="12dp"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_cast_connected" />

    <!-- 画面ロック中だけ表示する解除ボタン（切り欠き・バーの分の余白はコードで足す） -->
    <ImageButton
        android:id="@+id/unlockButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="start|center_vertical"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/unlock"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />

    <!-- 続きから再生したときに少しだけ出す「最初から再生」（切り欠き・バーの分の余白はコードで足す） -->
    <TextView
        android:id="@+id/restartButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/bg_info"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/player_restart"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_replay" />

    <!-- シークバーを動かしている間に出す、その位置の画像と時間（位置はコードで合わせる） -->
    <LinearLayout
        android:id="@+id/seekPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_info"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seekPreviewImage"
            android:layout_width="176dp"
            android:layout_height="99dp"
            android:background="@android:color/black"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/seekPreviewTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 再生できなかったときの表示（理由・再試行・閉じる） -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_info"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_err_alert" />

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/player_error_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="360dp"
            android:maxLines="8"
            android:ellipsize="end"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/errorClose"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/close"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/errorRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_retry"
                app:icon="@drawable/ic_replay"
                app:iconTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/gestureInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_info"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
