<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- タップ・スワイプなどのジェスチャーを受け取る透明なレイヤー -->
    <View
        android:id="@+id/touchLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 上部バー -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/titleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- A-Bリピート中の表示（タップで解除） -->
        <TextView
            android:id="@+id/abIndicator"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_ab_badge"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/aspectButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/aspect"
            android:src="@drawable/ic_aspect" />

        <ImageButton
            android:id="@+id/rotateButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/rotate"
            android:src="@drawable/ic_rotate" />

        <ImageButton
            android:id="@+id/castButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/cast"
            android:src="@drawable/ic_cast" />

        <ImageButton
            android:id="@+id/pipButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/pip"
            android:src="@drawable/ic_pip" />

        <ImageButton
            android:id="@+id/moreButton"
            style="@style/PlayerButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- 下部コントロール -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCurrent"
                style="@style/PlayerTime"
                android:text="0:00" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="12dp" />

            <TextView
                android:id="@+id/timeDuration"
                style="@style/PlayerTime"
                android:text="0:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/lockButton"
                style="@style/PlayerButton"
                android:contentDescription="@string/lock"
                android:src="@drawable/ic_lock_open" />

            <ImageButton
                android:id="@+id/subtitleButton"
                style="@style/PlayerButton"
                android:contentDescription="@string/subtitles"
                android:src="@drawable/ic_subtitles" />

            <ImageButton
                android:id="@+id/audioButton"
                style="@style/PlayerButton"
                android:contentDescription="@string/audio_track"
                android:src="@drawable/ic_audiotrack" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/prevButton"
                style="@style/PlayerButton"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/playButton"
                style="@style/PlayerButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/play_pause"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/nextButton"
                style="@style/PlayerButton"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_skip_next" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/speedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:paddingHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/speed"
                android:gravity="center"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/repeatButton"
                style="@style/PlayerButton"
                android:alpha="0.5"
                android:contentDescription="@string/repeat"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>
    </LinearLayout>

    <!-- キャスト中の表示 -->
    <TextView
        android:id="@+id/castInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="12dp"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_cast_connected" />

    <!-- 画面ロック中だけ表示する解除ボタン -->
    <ImageButton
        android:id="@+id/unlockButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/unlock"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gestureInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_info"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
