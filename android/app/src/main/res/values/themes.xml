<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 一覧などの画面。設定で「明るい／暗い／端末に合わせる」を切り替える（色は colors.xml） -->
    <style name="Theme.VideoPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
    </style>

    <!-- 動画の再生画面は、テーマの設定にかかわらずいつも暗い -->
    <style name="Theme.VideoPlayer.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#4F8CFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:colorBackground">#0F1115</item>
        <item name="colorSurface">#181B22</item>
        <item name="android:windowBackground">@android:color/black</item>
        <!-- アイコンは白（明るさに関係なく見やすく） -->
        <item name="colorControlNormal">#FFFFFF</item>
    </style>

    <!-- 押しやすい大きさのアイコンボタン（48dp 四方、アイコンは 26dp） -->
    <style name="PlayerButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 再生画面の下の道具ボタン（画面の幅に合わせて均等に並べる） -->
    <style name="PlayerToolButton" parent="PlayerButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">13dp</item>
    </style>

    <style name="PlayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
