<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 一覧などの画面。設定で「明るい／暗い／端末に合わせる」を切り替える（色は colors.xml） -->
    <style name="Theme.VideoPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/role_on_primary</item>
        <item name="colorPrimaryContainer">@color/role_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/role_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/role_inverse_primary</item>
        <item name="colorSecondary">@color/role_secondary</item>
        <item name="colorOnSecondary">@color/role_on_secondary</item>
        <item name="colorSecondaryContainer">@color/role_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/role_on_secondary_container</item>
        <item name="colorTertiary">@color/role_tertiary</item>
        <item name="colorOnTertiary">@color/role_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/role_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/role_on_tertiary_container</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorSurfaceDim">@color/role_surface_dim</item>
        <item name="colorSurfaceBright">@color/role_surface_bright</item>
        <!-- ダイアログ・メニュー・下から出るシートなどの背景 -->
        <item name="colorSurfaceContainerLowest">@color/role_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/role_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/role_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/role_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/role_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/role_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/role_inverse_on_surface</item>
        <item name="colorOutline">@color/role_outline</item>
        <item name="colorOutlineVariant">@color/role_outline_variant</item>
    </style>

    <!-- 起動中の画面（Android 12 以降のスプラッシュ画面。古い端末でも同じ見た目にする） -->
    <style name="Theme.VideoPlayer.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <!-- アイコンの再生マークは白なので、アクセントの青の丸の上に置く -->
        <item name="windowSplashScreenIconBackgroundColor">@color/accent</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VideoPlayer</item>
    </style>

    <!-- 動画の再生画面は、テーマの設定にかかわらずいつも暗い -->
    <style name="Theme.VideoPlayer.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#4F8CFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:colorBackground">#0F1115</item>
        <item name="colorSurface">#181B22</item>
        <item name="android:windowBackground">@android:color/black</item>
        <!-- アイコンは白（明るさに関係なく見やすく） -->
        <item name="colorControlNormal">#FFFFFF</item>
    </style>

    <!-- 押しやすい大きさのアイコンボタン（48dp 四方、アイコンは 26dp） -->
    <style name="PlayerButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 自由な小窓のボタン（小さな窓でも並ぶように小さめ） -->
    <style name="PopupButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 再生画面の下の道具ボタン（画面の幅に合わせて均等に並べる） -->
    <style name="PlayerToolButton" parent="PlayerButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">13dp</item>
    </style>

    <style name="PlayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
