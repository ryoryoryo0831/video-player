<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="字幕">
        <ListPreference
            app:defaultValue="16"
            app:entries="@array/sub_size_labels"
            app:entryValues="@array/sub_size_values"
            app:iconSpaceReserved="false"
            app:key="sub_size"
            app:title="文字の大きさ"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="16777215"
            app:entries="@array/sub_color_labels"
            app:entryValues="@array/sub_color_values"
            app:iconSpaceReserved="false"
            app:key="sub_color"
            app:title="文字の色"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="4"
            app:entries="@array/sub_outline_labels"
            app:entryValues="@array/sub_outline_values"
            app:iconSpaceReserved="false"
            app:key="sub_outline"
            app:title="縁取り"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="sub_bold"
            app:title="太字" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="sub_background"
            app:summary="字幕の後ろに半透明の黒い帯を付けます"
            app:title="背景を付ける" />
        <Preference
            app:iconSpaceReserved="false"
            app:selectable="false"
            app:summary="SRT などの文字の字幕に反映されます（ASS 字幕は字幕ファイルの指定どおりに表示されます）。次に動画を開いたときから反映されます。" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="再生">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="resume"
            app:summary="途中まで見た動画を、前回の位置から再生します"
            app:title="続きから再生" />
        <ListPreference
            app:defaultValue="PIP"
            app:entries="@array/leave_action_labels"
            app:entryValues="@array/leave_action_values"
            app:iconSpaceReserved="false"
            app:key="leave_action"
            app:title="動画の画面を離れたとき"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="auto_rotate"
            app:summary="横長の動画は横向き、縦長の動画は縦向きにします"
            app:title="動画に合わせて画面を回転" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="audio_boost"
            app:summary="音量を最大にしたあと、さらに 200% まで上げられるようにします（音が割れることがあります）"
            app:title="音量ブースト" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="hw_decoding"
            app:summary="オフにすると、映像が乱れる・緑色になるなどの問題が直ることがあります（電池の消費は増えます）。動画ごとに切り替えるには再生画面の「︙」から"
            app:title="ハードウェアデコード" />
        <ListPreference
            app:defaultValue="-1"
            app:entries="@array/deinterlace_labels"
            app:entryValues="@array/deinterlace_values"
            app:iconSpaceReserved="false"
            app:key="deinterlace"
            app:title="インターレース解除（テレビ録画などの横縞を消す）"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="1500"
            app:entries="@array/network_caching_labels"
            app:entryValues="@array/network_caching_values"
            app:iconSpaceReserved="false"
            app:key="network_caching"
            app:title="ネットワーク再生の先読み"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="ジェスチャー（動画の再生画面）">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_brightness"
            app:title="左側の上下スワイプで明るさ" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_volume"
            app:title="右側の上下スワイプで音量" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_seek"
            app:title="左右スワイプで早送り・巻き戻し" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_double_tap"
            app:summary="左側で戻る、右側で進む、真ん中で再生／一時停止"
            app:title="ダブルタップでスキップ" />
        <ListPreference
            app:defaultValue="10"
            app:dependency="gesture_double_tap"
            app:entries="@array/double_tap_labels"
            app:entryValues="@array/double_tap_values"
            app:iconSpaceReserved="false"
            app:key="double_tap_seconds"
            app:title="スキップする秒数"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="表示">
        <ListPreference
            app:defaultValue="dark"
            app:entries="@array/theme_labels"
            app:entryValues="@array/theme_values"
            app:iconSpaceReserved="false"
            app:key="theme"
            app:title="テーマ（一覧の画面の明るさ）"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="一覧">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="videos_grid"
            app:summary="「動画」タブをサムネイルの大きいグリッドで表示します"
            app:title="動画をグリッドで表示" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="情報">
        <Preference
            app:iconSpaceReserved="false"
            app:key="version"
            app:selectable="false"
            app:title="バージョン" />
        <Preference
            app:iconSpaceReserved="false"
            app:selectable="false"
            app:summary="再生エンジンに libVLC（VideoLAN）を使用しています"
            app:title="再生エンジン" />
    </PreferenceCategory>
</PreferenceScreen>
